 /* Square corners everywhere; only the round logo and search icon keep curves */
 *, *::before, *::after, .maplibregl-ctrl-group, .maplibregl-popup-content, .maplibregl-ctrl-attrib { border-radius: 0 !important; }
 .logo, .search-ico { border-radius: 50% !important; }
+
+/* ---- v8: layer control, burned-area legend, province mode */
+.toolbar .mode-region { display: none; }
+.toolbar[data-mode="region"] .mode-region { display: flex; align-self: center; }
+.mode-region .hint { margin: 0; }
+.layer-ctrl { background: var(--panel); border: 1px solid var(--line); color: var(--ink); font-size: .78rem; min-width: 190px; }
+.layer-ctrl .lc-head { width: 100%; text-align: left; background: transparent; border: 0; border-bottom: 1px solid var(--line);
+  font-weight: 600; padding: .35rem .6rem; }
+.layer-ctrl.collapsed .lc-body { display: none; }
+.layer-ctrl.collapsed .lc-head { border-bottom: 0; }
+.lc-body { display: flex; flex-direction: column; gap: .2rem; padding: .4rem .6rem .5rem; }
+.lc-body label { display: flex; align-items: center; gap: .4rem; cursor: pointer; white-space: nowrap; }
+.lc-body input { margin: 0; accent-color: #8ab4f8; }
+.lc-sub { padding-left: 1.2rem; display: flex; flex-direction: column; gap: .15rem; color: var(--muted); }
+.lc-note { margin: .2rem 0 0; color: var(--muted); font-size: .72rem; max-width: 190px; white-space: normal; }
+.legend-burn { bottom: 112px; }
+.ramp-burn { background: linear-gradient(90deg, #dfe4f0, #b6c7e0, #8fb0d4, #5f95c4, #3a78b0, #1d5f95, #0b4a7a, #023858); }
+@media (max-width: 760px) { .legend-burn { top: 84px; bottom: auto; } .layer-ctrl { min-width: 0; } }
+.card.loading { opacity: .35; transition: opacity .2s; }
